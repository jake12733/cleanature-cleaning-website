  <!-- ================= JAVASCRIPT LOGIC ================= -->
  <script>
    // 1. Mobile Menu Toggle
    const mobileBtn = document.getElementById('mobile-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
    document.querySelectorAll('.mobile-link').forEach(link => {
      link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
    });

    // 2. Services Tab Data & Switcher
    const serviceData = {
      movein: {
        title: '입주 · 이사 청소',
        subtitle: '공사 분진, 유해 유기화합물 제거 및 새 공간 안심 입주 케어',
        desc: '새 아파트 및 인테리어 리모델링 후 발생하는 미세 시멘트 가루, 톱밥, 도배풀, 실리콘 잔여물과 새집증후군 유발 물질을 전용 고성능 집진기와 160도 고온 스팀으로 완벽히 박리합니다.',
        price: '평당 14,000원 ~ 18,000원 선',
        target: '신축 아파트 입주자, 인테리어 직후 세대',
        img: '/src/assets/images/cleanature_hero_penthouse_1793016338692.jpg'
      },
      living: {
        title: '거주 공간 프리미엄 딥케어',
        subtitle: '일상 청소로 지워지지 않는 묵은 때, 곰팡이, 기름때 집중 살균',
        desc: '생활하면서 차곡차곡 쌓인 주방 후드 굳은 기름때, 욕실 실리콘 곰팡이, 창문 틈새 찌든 먼지를 독일제 친환경 약품과 특수 브러시로 마감재 손상 없이 원래의 청결한 컨디션으로 되돌립니다.',
        price: '평당 16,000원 ~ 20,000원 선',
        target: '정기 대청소가 필요한 세대, 영유아·반려동물 가정',
        img: '/src/assets/images/cleanature_bathroom_spa_1793016340535.jpg'
      },
      office: {
        title: '프리미엄 오피스 & 사옥 관리',
        subtitle: '기업의 브랜드 품격을 높이고 임직원의 생산성을 지키는 업무 공간 케어',
        desc: '임원실, 중역 회의실, 오픈 데스크, 탕비실, 로비까지 체계적인 동선 계획을 수립하여 주말 및 야간 시간대를 활용해 업무 공백 없이 쾌적한 비즈니스 환경을 유지합니다.',
        price: '실평수 및 방문 주기(주 1~5회) 맞춤 견적',
        target: 'IT 스타트업, 법무/회계법인 사옥, 외국계 기업',
        img: '/src/assets/images/cleanature_office_commercial_1793016339915.jpg'
      },
      commercial: {
        title: '상업시설 & 플래그십 쇼룸',
        subtitle: '오픈 첫날 고객에게 완벽한 첫인상을 심어주는 상업시설 준공 클리닝',
        desc: '레스토랑, 카페, 패션 브랜드 쇼룸, 갤러리 등 인테리어 공사 마감 후 남은 실리콘, 페인트 튐, 유리창 테이프 자국을 말끔히 정리하여 완성도 높은 공간으로 탄생시킵니다.',
        price: '업종 및 층고별 현장 방문 실측 견적',
        target: '오픈 예정 매장, 리뉴얼 인테리어 쇼룸',
        img: '/src/assets/images/cleanature_kitchen_detail_1793016340279.jpg'
      }
    };

    function switchServiceTab(key) {
      document.querySelectorAll('.service-tab-btn').forEach(btn => {
        btn.classList.remove('bg-white', 'text-slate-950', 'shadow-xs');
        btn.classList.add('text-slate-600');
      });
      const activeBtn = document.getElementById('tab-btn-' + key);
      activeBtn.classList.add('bg-white', 'text-slate-950', 'shadow-xs');
      activeBtn.classList.remove('text-slate-600');

      const data = serviceData[key];
      document.getElementById('svc-title').textContent = data.title;
      document.getElementById('svc-subtitle').textContent = data.subtitle;
      document.getElementById('svc-desc').textContent = data.desc;
      document.getElementById('svc-price').textContent = data.price;
      document.getElementById('svc-target').textContent = data.target;
      document.getElementById('svc-img').src = data.img;
    }

    // 3. Quote Calculator Logic
    let currentCalcRate = 15000;
    let currentCalcKey = 'movein';
    let currentArea = 34;

    function selectCalcService(key, rate) {
      currentCalcKey = key;
      currentCalcRate = rate;
      document.querySelectorAll('.calc-btn').forEach(b => {
        b.className = 'calc-btn p-2.5 rounded-xl font-medium border text-left bg-white text-slate-700 border-slate-200';
      });
      const activeBtn = document.getElementById('calc-svc-' + key);
      activeBtn.className = 'calc-btn p-2.5 rounded-xl font-medium border text-left bg-slate-900 text-white border-slate-900';
      calculateQuote();
    }

    function updateArea(val) {
      currentArea = Number(val);
      document.getElementById('area-val-text').textContent = val + '평 (' + Math.round(val * 3.3) + '㎡)';
      calculateQuote();
    }

    function calculateQuote() {
      let base = currentArea * currentCalcRate;
      let addons = 0;
      if (document.getElementById('addon-phyto').checked) addons += 50000;
      if (document.getElementById('addon-window').checked) addons += 120000;
      let total = base + addons;
      document.getElementById('calc-total-text').textContent = total.toLocaleString() + '원';
    }

    // 4. Form Validation & Simulation Submission
    function handleFormSubmit(e) {
      e.preventDefault();
      const name = document.getElementById('cust-name').value.trim();
      const phone = document.getElementById('cust-phone').value.trim();
      const loc = document.getElementById('cust-loc').value.trim();
      const date = document.getElementById('cust-date').value;
      const notes = document.getElementById('cust-notes').value.trim();
      const errEl = document.getElementById('error-msg');

      errEl.classList.add('hidden');

      if (name.length < 2) {
        errEl.textContent = '고객 성함을 2자 이상 입력해 주세요.';
        errEl.classList.remove('hidden');
        return;
      }

      const phoneRegex = /^01[0-9]-?[0-9]{3,4}-?[0-9]{4}$/;
      if (!phoneRegex.test(phone.replace(/\s+/g, ''))) {
        errEl.textContent = '올바른 휴대폰 번호 형식(010-0000-0000)을 입력해 주세요.';
        errEl.classList.remove('hidden');
        return;
      }

      // Generate Receipt
      const randId = 'SIM-CLEAN-' + Math.floor(100000 + Math.random() * 900000);
      document.getElementById('receipt-id').textContent = randId;

      document.getElementById('receipt-body').innerHTML = `
        <div class="grid grid-cols-2 gap-2 p-3 bg-slate-50 rounded-xl">
          <div><span class="text-slate-400">고객명:</span> <strong>${name}</strong></div>
          <div><span class="text-slate-400">연락처:</span> <strong>${phone}</strong></div>
          <div><span class="text-slate-400">시공지역:</span> <strong>${loc}</strong></div>
          <div><span class="text-slate-400">희망일자:</span> <strong>${date}</strong></div>
        </div>
        <div class="pt-2 border-t space-y-1">
          <div class="flex justify-between"><span>서비스:</span> <strong>${serviceData[currentCalcKey].title} (${currentArea}평)</strong></div>
          <div class="flex justify-between"><span>예상 시공 견적:</span> <strong class="text-slate-900 text-sm">${document.getElementById('calc-total-text').textContent}</strong></div>
          ${notes ? `<div class="p-2 bg-slate-50 rounded-lg text-slate-600 mt-2">요청사항: ${notes}</div>` : ''}
        </div>
      `;

      document.getElementById('inquiry-form-container').classList.add('hidden');
      document.getElementById('receipt-container').classList.remove('hidden');
    }

    function resetQuoteForm() {
      document.getElementById('inquiry-form-container').classList.remove('hidden');
      document.getElementById('receipt-container').classList.add('hidden');
      document.getElementById('quote-form').reset();
    }

    // Set default date to 7 days later
    const defaultDate = new Date();
    defaultDate.setDate(defaultDate.getDate() + 7);
    document.getElementById('cust-date').value = defaultDate.toISOString().substring(0, 10);
  </script>
